{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/beyond10x/swell/bench/schema/swell-bench-1.json",
  "title": "swell-bench/1",
  "description": "One run of the measurement harness of bench/ (bench/run.sh): K2 to K5 of docs/design/quality-and-comparison.md section 1 for each engine configuration. Agreed with the codespec maintainers (docs/design/native-code.md Q12): a script or engine that is refused or fails is a row with its reason, never a missing row. Fields may be added; none of the required ones is removed within version 1.",
  "type": "object",
  "required": ["format", "date", "commit", "host", "rows"],
  "properties": {
    "format": { "const": "swell-bench/1" },
    "date": { "type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$", "description": "UTC date of the run." },
    "commit": { "type": "string", "pattern": "^[0-9a-f]{40}$", "description": "The swell commit the harness ran at." },
    "host": {
      "type": "object",
      "required": ["arch", "cpus", "runner"],
      "properties": {
        "arch": { "type": "string", "minLength": 1 },
        "cpus": { "type": "integer", "minimum": 1 },
        "runner": { "type": "string", "minLength": 1 },
        "cpu_model": { "type": "string" },
        "kernel": { "type": "string" },
        "container_runtime": { "type": "string" }
      }
    },
    "image_digest": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
    "harness_digest": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
    "limits": { "type": "object" },
    "engines": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["engine", "version", "sha256", "url"],
        "properties": {
          "engine": { "type": "string", "minLength": 1 },
          "version": { "type": "string", "minLength": 1 },
          "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
          "url": { "type": "string", "pattern": "^https://" }
        }
      }
    },
    "suites": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["suite", "repo", "commit", "files"],
        "properties": {
          "suite": { "type": "string", "minLength": 1 },
          "repo": { "type": "string", "pattern": "^https://" },
          "commit": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
          "files": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "required": ["file", "sha256", "licence"],
              "properties": {
                "file": { "type": "string", "minLength": 1 },
                "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
                "licence": { "type": "string", "minLength": 1 }
              }
            }
          }
        }
      }
    },
    "rows": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/row" }
    }
  },
  "$defs": {
    "row": {
      "type": "object",
      "required": ["engine", "version", "mode", "flags", "kpi", "measurement", "unit", "runs", "values", "median", "status", "reason"],
      "properties": {
        "engine": { "type": "string", "minLength": 1 },
        "config": { "type": "string", "minLength": 1 },
        "version": { "type": "string", "minLength": 1 },
        "mode": { "enum": ["interpreter", "jit"] },
        "flags": { "type": "array", "items": { "type": "string", "minLength": 1 } },
        "env": { "type": "array", "items": { "type": "string", "pattern": "^[A-Za-z_][A-Za-z0-9_]*=" } },
        "flags_verified": { "type": "boolean" },
        "kpi": { "enum": ["K2", "K3", "K4", "K5"] },
        "measurement": { "type": "string", "minLength": 1 },
        "unit": { "enum": ["ms", "µs", "bytes"] },
        "runs": { "type": "integer", "minimum": 0 },
        "values": { "type": "array", "items": { "type": "number", "minimum": 0 } },
        "median": { "type": ["number", "null"] },
        "min": { "type": ["number", "null"] },
        "max": { "type": ["number", "null"] },
        "status": { "enum": ["measured", "refused", "not-measured"] },
        "reason": { "type": "string" },
        "image_digest": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
        "suite_commit": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
        "load": {
          "type": "object",
          "required": ["start", "end", "cpus"],
          "properties": {
            "start": { "type": "number", "minimum": 0 },
            "end": { "type": "number", "minimum": 0 },
            "cpus": { "type": "integer", "minimum": 1 }
          }
        },
        "loaded": { "type": "boolean" }
      },
      "allOf": [
        {
          "if": { "properties": { "status": { "const": "measured" } } },
          "then": { "properties": { "runs": { "minimum": 1 }, "values": { "minItems": 1 }, "median": { "type": "number" } } },
          "else": { "properties": { "reason": { "minLength": 1 }, "median": { "type": "null" } } }
        },
        {
          "if": { "properties": { "kpi": { "const": "K2" } } },
          "then": { "properties": { "unit": { "const": "ms" } } }
        },
        {
          "if": { "properties": { "kpi": { "const": "K3" } } },
          "then": { "properties": { "unit": { "const": "µs" } } }
        },
        {
          "if": { "properties": { "kpi": { "enum": ["K4", "K5"] } } },
          "then": { "properties": { "unit": { "const": "bytes" } } }
        }
      ]
    }
  }
}
